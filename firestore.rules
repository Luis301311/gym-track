rules_version = '2';

// Cada usuario solo puede leer y escribir lo que está bajo users/{su uid}:
// su perfil, rutinas, entrenamientos, peso y medidas. Nadie más.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
