rules_version = '2';

// Cada usuario solo puede leer y escribir lo que está bajo users/{su uid}:
// su perfil, rutinas, entrenamientos, peso y medidas. Nadie más.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/{collection}/{rest=**} {
      allow read: if isOwner(uid);
      // ai_usage es el contador del coach con IA: solo lo escribe la
      // Cloud Function (con permisos de administrador), así nadie se salta
      // el límite diario.
      allow write: if isOwner(uid) && collection != 'ai_usage';
    }
  }
}
